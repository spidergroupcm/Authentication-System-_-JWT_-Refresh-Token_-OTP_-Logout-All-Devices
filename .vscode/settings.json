{
  // ✨ Editor Styling
  "editor.fontSize": 16,
  "editor.fontFamily": "Fira Code, JetBrains Mono, Consolas, 'Courier New', monospace",
  "editor.fontLigatures": true,
  "editor.lineHeight": 26,
  "editor.letterSpacing": 0.5,
  "editor.cursorBlinking": "expand",
  "editor.renderWhitespace": "selection",
  "editor.tabSize": 2,
  "editor.formatOnSave": true,
  "editor.mouseWheelZoom": true,
  "editor.minimap.enabled": false,
 

  // 🌈 UI Theme & Design

  "workbench.iconTheme": "material-icon-theme",
  "workbench.statusBar.visible": true,
  "workbench.startupEditor": "none",                       // Start clean
  "workbench.editor.highlightModifiedTabs": true,
  "workbench.sideBar.location": "left",                    // Can be "right" if preferred
  "window.zoomLevel": 1.2,                                 // Scales sidebar and text


  // 🖥️ Terminal Customization
  "terminal.integrated.defaultProfile.windows": "Git Bash",
  "terminal.integrated.fontFamily": "Fira Code, JetBrains Mono, monospace",
  "terminal.integrated.fontSize": 16,
  "terminal.integrated.cursorStyle": "line",
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.scrollback": 10000,
  "terminal.integrated.drawBoldTextInBrightColors": false,
  "git.ignoreLimitWarning": true,


}
